  "cards": [
    {
      "dot": "cyan",
      "title": "One tool definition",
      "items": [
        "Both paths serve the same ten tools from src/shared/tools.py",
        "That file is COPYed into the agent image and the mcp image at build"
      ]
    },
    {
      "dot": "amber",
      "title": "The MCP_ENABLED toggle",
      "items": [
        "False (the current value) - agent binds LangChain @tool functions in-process",
        "True - agent opens an MCP session to mcp:8011/mcp and load_mcp_tools() adapts them"
      ]
    },
    {
      "dot": "violet",
      "title": "Reaching mcp from the host",
      "items": [
        "Compose publishes mcp with no fixed host port; Docker picks an ephemeral one",
        "Envoy has no /mcp route - /chatbot/ is the only agent-layer route"
      ]
    },
    {
      "dot": "emerald",
      "title": "Only with the agent layer",
      "items": [
        "agent, mcp and chatbot live in compose.agent.yaml, not compose.yaml",
        "Both export OTLP through the Traceloop SDK"
      ]
    }
