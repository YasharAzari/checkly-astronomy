  "cards": [
    {
      "dot": "cyan",
      "title": "The collector both receives and pulls",
      "items": [
        "otlp receiver takes pushed traces, metrics and logs from every service",
        "prometheus/ad scrapes ad:9465 \u2014 the demo's non-OTel bridging example",
        "redis, postgresql, kafkametrics, nginx, docker_stats and host_metrics all pull",
        "span_metrics derives RED metrics from the traces pipeline"
      ]
    },
    {
      "dot": "emerald",
      "title": "Three signals, three databases",
      "items": [
        "Traces to Jaeger over OTLP gRPC \u2014 pure in-memory, capped at 25,000 traces",
        "Metrics to Prometheus over OTLP HTTP at /api/v1/otlp \u2014 its own TSDB, 7 day retention",
        "Logs to OpenSearch bulk HTTP, index otel-logs-<date> \u2014 Lucene, wiped on restart",
        "Metrics never reach OpenSearch; logs never reach Prometheus"
      ]
    },
    {
      "dot": "amber",
      "title": "Traps worth knowing",
      "items": [
        "Prometheus scrapes nothing \u2014 it is push-fed, so `up` returns zero series and looks dead",
        "Grafana only reads; it stores no telemetry and is not in the write path",
        "A full disk makes OpenSearch mark the index read-only and logs stop silently",
        "Only Prometheus has real history \u2014 derive check thresholds from it, not from spot samples"
      ]
    }
  ]
