# Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#
# One file, two consumers:
#   * the Checkly CLI          — npx checkly test / deploy, run from this directory
#   * the Private Location agent — private-location/compose.yaml, which reads ../.env

# --- Checkly CLI -----------------------------------------------------------
# Account → Settings → User API keys. Both are shown by `npx checkly login`,
# which also writes them to ~/.config/checkly — these are for non-interactive use.
CHECKLY_API_KEY=cu_replace_me
CHECKLY_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# --- Private Location agent ------------------------------------------------
# Settings → Account → Private Locations → your location → "Add API key".
# This is the *private location* key (pl_...), not the user key (cu_...) above.
# The name is plain `API_KEY` because that is what checkly/agent reads; the
# compose file keeps the CHECKLY_* values above out of the agent container.
API_KEY=pl_replace_me

# --- Optional agent tuning -------------------------------------------------
# Anything else set here is passed through to the agent container as-is.
# LOG_LEVEL=DEBUG        # DEBUG | INFO | WARN | ERROR   (default INFO)
# JOB_CONCURRENCY=2      # checks run in parallel per agent (default 1)
